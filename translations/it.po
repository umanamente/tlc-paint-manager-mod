msgid "Waiting for the current backpack and paint storage."
msgstr "In attesa dei dati aggiornati dello zaino e delle scorte di vernice."

#. Shown when a gather or return action is disabled because the installed game build has not been verified.
#: src/PaintManager/Scripts/paintmanager/locales/en_main.lua:50 src/PaintManager/Scripts/main.lua
msgctxt "main.transfer.build_unverified"
msgid "Paint transfers require the verified game build."
msgstr "Per trasferire le vernici è necessaria la versione verificata del gioco."

#. Gather/return refusal when none of the selected paint can be moved under the current stock or return rules.
#: src/PaintManager/Scripts/paintmanager/locales/en_main.lua:52 src/PaintManager/Scripts/paintmanager/player_messages.lua src/PaintManager/Scripts/paintmanager/transfer_controls.lua
msgctxt "main.transfer.unavailable"
msgid "No eligible paint is available for this transfer."
msgstr "Nessuna vernice disponibile soddisfa i requisiti per questo trasferimento."

#. Gather selected paint button. {count} is the configured target for this color in the backpack; the current stock already meets it.
#: src/PaintManager/Scripts/paintmanager/locales/en_main.lua:55 src/PaintManager/Scripts/paintmanager/transfer_controls.lua
#, python-brace-format
msgctxt "main.transfer.target_reached"
msgid "Your backpack already holds the target of {count} can or more."
msgid_plural "Your backpack already holds the target of {count} cans or more."
msgstr[0] "Hai già almeno {count} barattolo di questo colore nello zaino."
msgstr[1] "Hai già almeno {count} barattoli di questo colore nello zaino."

#. Transfer receipt shown after gathering or returning paint. {moved} counts confirmed moves; {skipped} counts candidates skipped.
#: src/PaintManager/Scripts/paintmanager/locales/en_main.lua:57 src/PaintManager/Scripts/paintmanager/transfer_controls.lua
#, python-brace-format
msgctxt "main.transfer.result"
msgid "Confirmed moves: {moved}. Skipped: {skipped}."
msgstr "Trasferimenti confermati: {moved}. Saltati: {skipped}."

#. Appended to the transfer receipt after an uncertain move; further transfers are blocked until the save is reloaded.
#: src/PaintManager/Scripts/paintmanager/locales/en_main.lua:59 src/PaintManager/Scripts/paintmanager/player_messages.lua src/PaintManager/Scripts/paintmanager/transfer_controls.lua
msgctxt "main.transfer.uncertain"
msgid "The last move could not be verified. Further transfers require reloading the save."
msgstr "Impossibile verificare l’ultimo trasferimento. Ricarica il salvataggio per effettuare altri trasferimenti."

#. Appended to the move receipt if some storage could not be read. Confirmed moves still count.
#: src/PaintManager/Scripts/paintmanager/locales/en_main.lua:61 src/PaintManager/Scripts/paintmanager/transfer_controls.lua
msgctxt "main.transfer.incomplete"
msgid "Some storage could not be checked."
msgstr "Impossibile controllare parte delle scorte."

#. Live status during a gather or return operation. {moved} is the number of confirmed moves so far.
#: src/PaintManager/Scripts/paintmanager/locales/en_main.lua:63 src/PaintManager/Scripts/main.lua
#, python-brace-format
msgctxt "main.transfer.running"
msgid "Moving paint cans. Moved: {moved}."
msgstr "Trasferimento dei barattoli di vernice. Già spostati: {moved}."

#. Persistence notice on the presets page. The account library was saved, but the in-game copy is still pending. {error} is optional storage detail.
#: src/PaintManager/Scripts/paintmanager/locales/en_main.lua:80 src/PaintManager/Scripts/main.lua
#, python-brace-format
msgctxt "main.storage.local_pending"
msgid "Saved locally; game mirror pending. Reopen the window or refresh configurations to reconcile. {error}"
msgstr "Dati salvati in locale. La copia nel gioco è in attesa. Riapri la finestra o aggiorna le configurazioni per sincronizzare le copie. {error}"

#. Presets storage warning after publishing the local file. {error} gives the verification or cleanup failure, if available.
#: src/PaintManager/Scripts/paintmanager/locales/en_main.lua:82 src/PaintManager/Scripts/main.lua
#, python-brace-format
msgctxt "main.storage.local_verification_uncertain"
msgid "Local JSON was published, but verification or cleanup failed; mirror pending. Refresh before editing. {error}"
msgstr "Il file JSON locale è stato scritto, ma la verifica o la pulizia non è riuscita. La copia nel gioco è in attesa. Aggiorna prima di apportare modifiche. {error}"

#. Presets storage warning after an uncertain write to the in-game mirror. {error} is optional detail about that attempt.
#: src/PaintManager/Scripts/paintmanager/locales/en_main.lua:84 src/PaintManager/Scripts/main.lua
#, python-brace-format
msgctxt "main.storage.local_uncertain"
msgid "Saved locally; game mirror uncertain. Further native attempts are blocked in this context. {error}"
msgstr "Dati salvati in locale. Lo stato della copia nel gioco è incerto. Ulteriori tentativi di scrittura nel gioco sono bloccati in questo contesto. {error}"

#. Presets storage notice after updating the account library and staging its mirror in the current save slot. The ordinary game save is still needed.
#: src/PaintManager/Scripts/paintmanager/locales/en_main.lua:86 src/PaintManager/Scripts/main.lua
msgctxt "main.storage.local_staged"
msgid "Local library saved; mirror staged in the loaded game. Save the game normally to persist it in this slot."
msgstr "La raccolta è salvata in locale e la copia è pronta nella partita in corso. Salva la partita normalmente per conservarla in questo slot."

#. Presets storage notice while confirmation of a local write is outstanding.
#: src/PaintManager/Scripts/paintmanager/locales/en_main.lua:88 src/PaintManager/Scripts/main.lua
msgctxt "main.storage.publication_pending"
msgid "Local publication is awaiting confirmation. Refresh configurations to check the library and game mirror."
msgstr "La scrittura locale è in attesa di conferma. Aggiorna le configurazioni per controllare la raccolta e la sua copia nel gioco."

#. Persistence warning on the presets page. {error} is the detail returned by the storage operation.
#: src/PaintManager/Scripts/paintmanager/locales/en_main.lua:96 src/PaintManager/Scripts/main.lua
#, python-brace-format
msgctxt "main.storage.unavailable"
msgid "Mod storage unavailable: {error}"
msgstr "Archivio della mod non disponibile: {error}"

#. Import refusal when the loaded game's mod data is not yet available.
#: src/PaintManager/Scripts/paintmanager/locales/en_main.lua:98 src/PaintManager/Scripts/main.lua
msgctxt "main.storage.not_ready"
msgid "Wait for mod data to load. If storage failed, inspect the error before changing this save."
msgstr "Attendi il caricamento dei dati della mod. In caso di errore di archiviazione, esaminalo prima di modificare questo salvataggio."

#. Presets import was requested while another command or preference write was in progress.
#: src/PaintManager/Scripts/paintmanager/locales/en_main.lua:100 src/PaintManager/Scripts/main.lua
msgctxt "main.storage.busy"
msgid "Wait for the current command to finish before importing configurations."
msgstr "Attendi la fine del comando in corso prima di importare le configurazioni."

#. Shown on the presets page or when importing on a game build for which persistence has not been verified.
#: src/PaintManager/Scripts/paintmanager/locales/en_main.lua:102 src/PaintManager/Scripts/main.lua src/PaintManager/Scripts/paintmanager/player_messages.lua
msgctxt "main.storage.build"
msgid "Saving PaintManager settings and presets requires the verified game build."
msgstr "Per salvare le impostazioni e le configurazioni di PaintManager è necessaria la versione verificata del gioco."

#. Result of applying a saved paint layout. {outcome} is the operation outcome, including failures and partial changes.
#: src/PaintManager/Scripts/paintmanager/locales/en_main.lua:117 src/PaintManager/Scripts/main.lua
#, python-brace-format
msgctxt "main.preset.result"
msgid "Preset result: {outcome}"
msgstr "Esito della configurazione: {outcome}"

#. Presets action requires a freshly read paint state and a current target: either character or ship.
#: src/PaintManager/Scripts/paintmanager/locales/en_main.lua:119 src/PaintManager/Scripts/main.lua src/PaintManager/Scripts/paintmanager/player_messages.lua
msgctxt "main.preset.refresh_required"
msgid "Refresh paint state and select the current target first."
msgstr "Aggiorna prima lo stato delle vernici e seleziona l’elemento attuale."

#. Saving/applying a preset failed because the character or ship paint zones could not all be read. May also appear in the game's paint editor.
#: src/PaintManager/Scripts/paintmanager/locales/en_main.lua:121 src/PaintManager/Scripts/main.lua src/PaintManager/Scripts/paintmanager/native_editor.lua src/PaintManager/Scripts/paintmanager/player_messages.lua
msgctxt "main.preset.target_incomplete"
msgid "The selected paint target is incomplete; inspect diagnostics and refresh."
msgstr "I dati dell’elemento da verniciare sono incompleti. Controlla la diagnostica e aggiorna."

#. Validation of a new preset name in PaintManager or the game's paint editor. The limit is in bytes rather than characters.
#: src/PaintManager/Scripts/paintmanager/locales/en_main.lua:123 src/PaintManager/Scripts/main.lua src/PaintManager/Scripts/paintmanager/native_editor.lua
msgctxt "main.preset.name_invalid"
msgid "Enter a configuration name (1–128 UTF-8 bytes, no control characters)."
msgstr "Inserisci un nome per la configurazione (da 1 a 128 byte in UTF-8, senza caratteri di controllo)."

#. Fallback refusal when a requested action, including a paint transfer, does not match a known command.
#: src/PaintManager/Scripts/paintmanager/locales/en_main.lua:135 src/PaintManager/Scripts/main.lua
msgctxt "main.queue.unknown"
msgid "Unknown command"
msgstr "Comando sconosciuto"

#. Command refusal while an indivisible operation is in progress.
#: src/PaintManager/Scripts/paintmanager/locales/en_main.lua:137 src/PaintManager/Scripts/main.lua
msgctxt "main.queue.atomic_busy"
msgid "Another atomic operation is running"
msgstr "È in corso un’altra operazione indivisibile."

#. A player action could not be queued because the pending command limit was reached.
#: src/PaintManager/Scripts/paintmanager/locales/en_main.lua:143 src/PaintManager/Scripts/main.lua
msgctxt "main.queue.full"
msgid "Command queue is full"
msgstr "La coda dei comandi è piena."

#. Fallback shown when an action cannot identify the character or game world currently in use.
#: src/PaintManager/Scripts/paintmanager/locales/en_main.lua:148 src/PaintManager/Scripts/main.lua src/PaintManager/Scripts/paintmanager/player_messages.lua
msgctxt "main.error.no_character"
msgid "No valid current character or world"
msgstr "Personaggio o mondo di gioco attuale non valido."

#. A scan or transfer stopped when the character/world no longer matched the one for which stock was read.
#: src/PaintManager/Scripts/paintmanager/locales/en_main.lua:150 src/PaintManager/Scripts/main.lua src/PaintManager/Scripts/paintmanager/player_messages.lua
msgctxt "main.error.context_changed"
msgid "Collection context changed; reopen the window to refresh nearby containers"
msgstr "Le condizioni del rilevamento sono cambiate. Riapri la finestra per aggiornare i contenitori nelle vicinanze."

#. Shared fallback when a stock scan, preset inspection or save operation failed and supplied no specific detail; it can appear in the game's paint editor.
#: src/PaintManager/Scripts/paintmanager/locales/en_main.lua:152 src/PaintManager/Scripts/main.lua src/PaintManager/Scripts/paintmanager/native_editor.lua
msgctxt "main.error.job_failed"
msgid "Collection job failed"
msgstr "Rilevamento delle vernici non riuscito."

#. Error fallback after a completed stock scan returned no results model.
#: src/PaintManager/Scripts/paintmanager/locales/en_main.lua:154 src/PaintManager/Scripts/main.lua
msgctxt "main.error.missing_model"
msgid "Completed collection job returned no model"
msgstr "Il rilevamento si è concluso senza restituire i dati della raccolta."

#. Action refused or interrupted because the player is outside the ship connection or the ship cannot be confirmed.
#: src/PaintManager/Scripts/paintmanager/locales/en_main.lua:156 src/PaintManager/Scripts/main.lua src/PaintManager/Scripts/paintmanager/player_messages.lua
msgctxt "main.connection.lost"
msgid "Signal lost. Move closer to the ship."
msgstr "Segnale perso. Avvicinati alla nave."

#. Fallback error when opening PaintManager requires a loaded save and a player-controlled character.
#: src/PaintManager/Scripts/paintmanager/locales/en_main.lua:158 src/PaintManager/Scripts/main.lua src/PaintManager/Scripts/paintmanager/player_messages.lua
msgctxt "main.error.load_character"
msgid "Load a save and leave vehicle controls"
msgstr "Carica un salvataggio e lascia i comandi del veicolo."

#. Fallback for a command interrupted by an error while drawing the PaintManager window.
#: src/PaintManager/Scripts/paintmanager/locales/en_main.lua:160 src/PaintManager/Scripts/main.lua src/PaintManager/Scripts/paintmanager/ui.lua
msgctxt "main.error.render_failed"
msgid "UI rendering failed"
msgstr "Impossibile visualizzare l’interfaccia."

#. Learn all refusal. No unlearned recipe has at least four cans of its color across eligible stock.
#: src/PaintManager/Scripts/paintmanager/locales/en_main.lua:167 src/PaintManager/Scripts/main.lua
msgctxt "main.bulk.none"
msgid "No locked recipe has four matching cans in your backpack and ship boxes combined."
msgstr "Per nessuna ricetta bloccata sono presenti, tra zaino e casse della nave, i quattro barattoli dello stesso colore richiesti."

#. Learn all receipt. {outcome} is the batch result; {learned}/{total} counts learned versus initially eligible recipes; {known}, {rejected} and {unverified} are other result counts.
#: src/PaintManager/Scripts/paintmanager/locales/en_main.lua:173 src/PaintManager/Scripts/main.lua
#, python-brace-format
msgctxt "main.bulk.result"
msgid "Batch {outcome}: learned {learned}/{total}; already known {known}; rejected {rejected}; unverified {unverified}."
msgstr "Apprendimento di gruppo: {outcome}. Ricette imparate: {learned}/{total}. Già note: {known}. Rifiutate: {rejected}. Non verificate: {unverified}."

#. Learn all was interrupted after a native attempt. {outcome} identifies its result; completed recipe grants remain in effect.
#: src/PaintManager/Scripts/paintmanager/locales/en_main.lua:175 src/PaintManager/Scripts/main.lua
#, python-brace-format
msgctxt "main.bulk.after_attempt"
msgid "Batch stopped: {outcome}. Recipes already granted remain learned; see the report."
msgstr "Apprendimento di gruppo interrotto: {outcome}. Le ricette già imparate restano tali. Consulta il rapporto."

#. Recipe learning refusal after the current player or world changed.
#: src/PaintManager/Scripts/paintmanager/locales/en_main.lua:181 src/PaintManager/Scripts/main.lua
msgctxt "main.learn.context_changed"
msgid "The player context changed. Reopen the window before learning."
msgstr "La situazione del personaggio è cambiata. Riapri la finestra prima di imparare la ricetta."

#. An action was requested while the PaintManager window was closing. The existing English is also reused for some preset and transfer actions.
#: src/PaintManager/Scripts/paintmanager/locales/en_main.lua:183 src/PaintManager/Scripts/main.lua src/PaintManager/Scripts/paintmanager/player_messages.lua
msgctxt "main.learn.window_closed"
msgid "The window closed before recipe learning started."
msgstr "La finestra è stata chiusa prima di iniziare a imparare la ricetta."

#. Recipe learning refusal on an unsupported build. The existing English is also reused by the preset-apply guard.
#: src/PaintManager/Scripts/paintmanager/locales/en_main.lua:185 src/PaintManager/Scripts/main.lua src/PaintManager/Scripts/paintmanager/player_messages.lua
msgctxt "main.learn.build_unverified"
msgid "Recipe learning is unavailable because the installed game build is not the verified reference build."
msgstr "Impossibile imparare ricette perché la versione installata del gioco è diversa da quella di riferimento verificata."

#. A shared busy guard refuses recipe learning; the existing English is also reused for preset and paint transfer actions.
#: src/PaintManager/Scripts/paintmanager/locales/en_main.lua:187 src/PaintManager/Scripts/main.lua src/PaintManager/Scripts/paintmanager/player_messages.lua
msgctxt "main.learn.busy"
msgid "Wait for the current command to finish before learning a recipe."
msgstr "Attendi la fine del comando in corso prima di imparare una ricetta."

#. Learn refusal when the current paint count is still missing or belongs to a different scan range.
#: src/PaintManager/Scripts/paintmanager/locales/en_main.lua:189 src/PaintManager/Scripts/main.lua
msgctxt "main.learn.refresh_required"
msgid "Reopen the window and wait for the ship stock count before learning."
msgstr "Riapri la finestra e attendi il conteggio delle scorte della nave prima di imparare la ricetta."

#. A fresh stock check contradicted the earlier count for one recipe. Four matching physical cans are required.
#: src/PaintManager/Scripts/paintmanager/locales/en_main.lua:191 src/PaintManager/Scripts/main.lua
msgctxt "main.learn.cached_stock_changed"
msgid "Could not confirm four matching cans in your backpack and the scanned ship boxes. Reopen the window to refresh."
msgstr "Impossibile confermare la presenza di quattro barattoli dello stesso colore tra zaino e casse della nave controllate. Riapri la finestra per aggiornare i dati."

#. Eligibility failure for one recipe: it must be locked and stock must contain four matching cans in total.
#: src/PaintManager/Scripts/paintmanager/locales/en_main.lua:193 src/PaintManager/Scripts/main.lua src/PaintManager/Scripts/paintmanager/player_messages.lua
msgctxt "main.learn.not_eligible"
msgid "Learning requires a locked recipe and four matching cans in your backpack and ship boxes combined."
msgstr "Per imparare una ricetta, questa deve essere bloccata e devi avere in tutto quattro barattoli del colore richiesto tra zaino e casse della nave."

#. Single-recipe error after a failed or unverified operation. {outcome} is the result or detailed error text.
#: src/PaintManager/Scripts/paintmanager/locales/en_main.lua:199 src/PaintManager/Scripts/main.lua
#, python-brace-format
msgctxt "main.learn.failed"
msgid "Recipe learning result: {outcome}. Check the report and log before retrying."
msgstr "Esito dell’apprendimento: {outcome}. Controlla il rapporto e il registro prima di riprovare."

#. Shown after interruption if a recipe-learning call already happened. {outcome} is that attempt's result.
#: src/PaintManager/Scripts/paintmanager/locales/en_main.lua:201 src/PaintManager/Scripts/main.lua
#, python-brace-format
msgctxt "main.learn.after_attempt"
msgid "The recipe call was already attempted: {outcome}. Closing or changing radius does not undo it."
msgstr "È già stato fatto un tentativo di apprendimento: {outcome}. Chiudere la finestra o cambiare il raggio non annulla il tentativo."

#. Status when changing the ship radius cancels the ongoing paint count. Reopening starts a count for the new range.
#: src/PaintManager/Scripts/paintmanager/locales/en_main.lua:221 src/PaintManager/Scripts/main.lua src/PaintManager/Scripts/paintmanager/player_messages.lua
msgctxt "main.cancel.radius_changed"
msgid "Range changed. Reopen the window to count paint in the new range."
msgstr "Il raggio è cambiato. Riapri la finestra per contare i barattoli nel nuovo raggio."

#. Fallback cancellation reason for a stopped refresh when no more specific player-facing explanation is available.
#: src/PaintManager/Scripts/paintmanager/locales/en_main.lua:223 src/PaintManager/Scripts/main.lua src/PaintManager/Scripts/paintmanager/player_messages.lua
msgctxt "main.cancel.default"
msgid "Refresh cancelled"
msgstr "Aggiornamento annullato"

#. Cancellation reason when closing PaintManager interrupts an operation. A transfer receipt can include this message.
#: src/PaintManager/Scripts/paintmanager/locales/en_main.lua:225 src/PaintManager/Scripts/main.lua src/PaintManager/Scripts/paintmanager/player_messages.lua
msgctxt "main.cancel.window_closed"
msgid "Window closed; unfinished refresh cancelled"
msgstr "Finestra chiusa. L’aggiornamento in corso è stato annullato."

#. Cancellation reason when the player closes the window while an action is still in the queue.
#: src/PaintManager/Scripts/paintmanager/locales/en_main.lua:227 src/PaintManager/Scripts/main.lua src/PaintManager/Scripts/paintmanager/player_messages.lua
msgctxt "main.cancel.before_start"
msgid "Window closed; command cancelled before starting"
msgstr "Finestra chiusa. Il comando è stato annullato prima dell’avvio."

#. Shown if the player changes a preference or favorite before preferences have loaded.
#: src/PaintManager/Scripts/paintmanager/locales/en_main.lua:238 src/PaintManager/Scripts/main.lua
msgctxt "main.settings.not_ready"
msgid "Wait for preferences to finish loading."
msgstr "Attendi il caricamento delle impostazioni."

#. Saving a setting or favorite was rejected because too many changes are already queued.
#: src/PaintManager/Scripts/paintmanager/locales/en_main.lua:240 src/PaintManager/Scripts/main.lua
msgctxt "main.settings.queue_full"
msgid "Too many pending changes. Try again shortly."
msgstr "Troppe modifiche in attesa. Riprova tra poco."

#. An invalid preference was rejected; also used for an invalid backpack target when gathering paint.
#: src/PaintManager/Scripts/paintmanager/locales/en_main.lua:242 src/PaintManager/Scripts/main.lua src/PaintManager/Scripts/paintmanager/transfer_controls.lua
msgctxt "main.settings.invalid"
msgid "This setting is unavailable."
msgstr "Questa impostazione non è disponibile."

#. Favorite action rejected because PaintManager cannot identify the selected paint reliably yet.
#: src/PaintManager/Scripts/paintmanager/locales/en_main.lua:244 src/PaintManager/Scripts/main.lua
msgctxt "main.settings.invalid_paint"
msgid "This paint cannot be added to favorites yet."
msgstr "Questa vernice non può ancora essere aggiunta ai preferiti."

#. Preference write failed or could not be verified. {error} is the returned reason.
#: src/PaintManager/Scripts/paintmanager/locales/en_main.lua:246 src/PaintManager/Scripts/main.lua
#, python-brace-format
msgctxt "main.settings.failed"
msgid "Preferences could not be confirmed: {error}"
msgstr "Impossibile confermare le impostazioni: {error}"

#. Cancellation notice after the player hides developer tools using the checkbox in ordinary Settings.
#: src/PaintManager/Scripts/paintmanager/locales/en_main.lua:251 src/PaintManager/Scripts/main.lua src/PaintManager/Scripts/paintmanager/player_messages.lua
msgctxt "main.settings.developer_hidden"
msgid "Developer tools were hidden."
msgstr "Gli strumenti per sviluppatori sono stati nascosti."
