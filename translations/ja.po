#. Status-line action name for opening, closing or refreshing the mod window.
#: src/PaintManager/Scripts/paintmanager/locales/en_ui.lua:5 src/PaintManager/Scripts/paintmanager/ui.lua
msgctxt "ui.command.window"
msgid "PaintManager window"
msgstr "PaintManagerウィンドウ"

#. Status-line action name while saving or applying the player's preferences.
#: src/PaintManager/Scripts/paintmanager/locales/en_ui.lua:7 src/PaintManager/Scripts/paintmanager/ui.lua
msgctxt "ui.command.preferences"
msgid "Settings"
msgstr "設定"

#. General status-line action name when the underlying command has no player-visible name.
#: src/PaintManager/Scripts/paintmanager/locales/en_ui.lua:9 src/PaintManager/Scripts/paintmanager/ui.lua
msgctxt "ui.command.task"
msgid "PaintManager action"
msgstr "PaintManagerの操作"

#. Label for the language selector in the mod's Settings. It controls messages written by PaintManager.
#: src/PaintManager/Scripts/paintmanager/locales/en_ui.lua:11 src/PaintManager/Scripts/paintmanager/ui.lua
msgctxt "ui.settings.language"
msgid "PaintManager language"
msgstr "PaintManagerの表示言語"

#. Default option in the language selector. Use the language of the game's interface when available and otherwise show English.
#: src/PaintManager/Scripts/paintmanager/locales/en_ui.lua:13 src/PaintManager/Scripts/paintmanager/ui.lua
msgctxt "ui.settings.language_auto"
msgid "Follow game language"
msgstr "ゲームの言語に合わせる"

#. Name of this translation in its own language. The Settings selector shows this name even when the rest of the interface is in a different language.
#: src/PaintManager/Scripts/paintmanager/locales/en_ui.lua:15 src/PaintManager/Scripts/paintmanager/i18n.lua
msgctxt "ui.settings.language_name"
msgid "English"
msgstr "日本語"

#. Settings tooltip for the language selector. Mention the automatic option using its label and explain when English is shown.
#: src/PaintManager/Scripts/paintmanager/locales/en_ui.lua:17
msgctxt "ui.settings.help.language"
msgid "Choose the language for PaintManager. Follow game language uses the game's interface language when a translation is available, and English otherwise."
msgstr "PaintManagerの表示言語を選びます。「ゲームの言語に合わせる」ではゲームと同じ言語を使います。翻訳がない場合は英語で表示します。"

#. Button in the selected preset details. Deletes the saved paint layout from the library.
#: src/PaintManager/Scripts/paintmanager/locales/en_ui.lua:24 src/PaintManager/Scripts/paintmanager/ui.lua
msgctxt "ui.preset.delete"
msgid "Delete"
msgstr "削除"

#. Help for the preset Delete button. Deletion affects the saved layout only.
#: src/PaintManager/Scripts/paintmanager/locales/en_ui.lua:26 src/PaintManager/Scripts/paintmanager/ui.lua
msgctxt "ui.preset.delete_help"
msgid "Permanently delete the selected saved configuration. Paints and current character or boat appearance are unchanged."
msgstr "選んだ塗装プリセットを完全に削除します。塗料や、キャラクターと船の現在の外観に影響はありません。"

#. Button on the presets page for importing saved paint configurations from local storage.
#: src/PaintManager/Scripts/paintmanager/locales/en_ui.lua:31 src/PaintManager/Scripts/paintmanager/ui.lua
msgctxt "ui.storage.import"
msgid "Import"
msgstr "インポート"

#. Main window title. This is the mod name, styled in all capitals.
#: src/PaintManager/Scripts/paintmanager/locales/en_ui.lua:33 src/PaintManager/Scripts/paintmanager/ui.lua
msgctxt "ui.title"
msgid "PAINT MANAGER"
msgstr "PAINT MANAGER"

#. Dismisses the main window or the native paint editor's finished save dialog.
#: src/PaintManager/Scripts/paintmanager/locales/en_ui.lua:38 src/PaintManager/Scripts/paintmanager/native_editor.lua src/PaintManager/Scripts/paintmanager/ui.lua
msgctxt "ui.button.close"
msgid "Close"
msgstr "閉じる"

#. Button added to the game's paint editor. Opens the mod's main window.
#: src/PaintManager/Scripts/paintmanager/locales/en_ui.lua:40 src/PaintManager/Scripts/paintmanager/ui.lua
msgctxt "ui.button.open_paintmanager"
msgid "Open PaintManager"
msgstr "PaintManagerを開く"

#. Main toolbar button for rereading the current paint configuration and saved presets. Also names a refresh in the status line.
#: src/PaintManager/Scripts/paintmanager/locales/en_ui.lua:42 src/PaintManager/Scripts/paintmanager/ui.lua
msgctxt "ui.button.refresh"
msgid "Refresh"
msgstr "更新"

#. Button on the selected paint card. Learns that color's recipe when four matching cans are available and keeps the cans.
#: src/PaintManager/Scripts/paintmanager/locales/en_ui.lua:44 src/PaintManager/Scripts/paintmanager/ui.lua
msgctxt "ui.button.learn_recipe"
msgid "Learn"
msgstr "習得"

#. Button above the paint list. Learns all eligible recipes, including those hidden by search or pagination.
#: src/PaintManager/Scripts/paintmanager/locales/en_ui.lua:46 src/PaintManager/Scripts/paintmanager/ui.lua
msgctxt "ui.button.learn_all"
msgid "Learn all"
msgstr "すべて習得"

#. Status-line name for transferring the selected paint color from ship boxes to the player's backpack.
#: src/PaintManager/Scripts/paintmanager/locales/en_ui.lua:48
msgctxt "ui.transfer.gather_paint"
msgid "Move selected paint to backpack"
msgstr "選んだ塗料をバックパックに移す"

#. Selected paint button. {quantity} is the desired total number of cans of this color in the backpack after transfer.
#: src/PaintManager/Scripts/paintmanager/locales/en_ui.lua:50 src/PaintManager/Scripts/paintmanager/ui.lua
#, python-brace-format
msgctxt "ui.transfer.gather_target"
msgid "Top up to {quantity}"
msgstr "{quantity}缶まで補充"

#. Selected paint button when the backpack target is All. Takes only this color, up to available space.
#: src/PaintManager/Scripts/paintmanager/locales/en_ui.lua:52 src/PaintManager/Scripts/paintmanager/ui.lua
msgctxt "ui.transfer.gather_color"
msgid "Take all of this color"
msgstr "この色をすべて取る"

#. Selected paint button. Returns one can previously brought by the mod to the box it came from.
#: src/PaintManager/Scripts/paintmanager/locales/en_ui.lua:54
msgctxt "ui.transfer.return_paint"
msgid "Return to original box"
msgstr "元の箱に戻す"

#. Bulk transfer button. Moves all colors from boxes in ship range to the player's backpack, up to capacity.
#: src/PaintManager/Scripts/paintmanager/locales/en_ui.lua:56
msgctxt "ui.transfer.gather_all"
msgid "Move all paints to backpack"
msgstr "すべての塗料をバックパックに移す"

#. Bulk return action, also available on the signal-lost page. Returns cans previously moved by the mod to their original boxes.
#: src/PaintManager/Scripts/paintmanager/locales/en_ui.lua:58
msgctxt "ui.transfer.return_all"
msgid "Return all paints to boxes"
msgstr "すべての塗料を元の箱に戻す"

#. Button added to the game's open storage box. Deposits cans of every color from the backpack into this box.
#: src/PaintManager/Scripts/paintmanager/locales/en_ui.lua:60 src/PaintManager/Scripts/paintmanager/native_deposit_widget.lua
msgctxt "ui.transfer.deposit_all_paints"
msgid "Deposit all paints"
msgstr "塗料をすべて収納"

#. Help for the selected paint transfer. {quantity} is the target backpack total for this color, including cans already carried.
#: src/PaintManager/Scripts/paintmanager/locales/en_ui.lua:62
#, python-brace-format
msgctxt "ui.transfer.gather_target_help"
msgid "Take this color from ship storage until you have {quantity} in your backpack, or as many as fit."
msgstr "バックパックにこの色が{quantity}缶そろうまで、船の収納箱から補充します。空きが足りない場合は入る分だけ取ります。"

#. Help for taking all cans of one selected color when the target quantity is All.
#: src/PaintManager/Scripts/paintmanager/locales/en_ui.lua:64
msgctxt "ui.transfer.gather_color_help"
msgid "Take as many cans of this color from ship storage as your backpack can hold."
msgstr "船の収納箱から、バックパックに入るだけこの色の塗料缶を取ります。"

#. Help for returning one can of the selected color. The mod remembers which box supplied the can.
#: src/PaintManager/Scripts/paintmanager/locales/en_ui.lua:66
msgctxt "ui.transfer.return_paint_help"
msgid "Return one can brought by PaintManager to its original box."
msgstr "PaintManagerで取り出した塗料缶を1缶、元の箱に戻します。"

#. Help for the bulk gather action. Extra cans of the same color are included.
#: src/PaintManager/Scripts/paintmanager/locales/en_ui.lua:68
msgctxt "ui.transfer.gather_all_help"
msgid "Move as many cans as fit from containers in ship range, including duplicate colors."
msgstr "船の周囲にある収納箱から、バックパックに入るだけ塗料缶を取ります。同じ色の缶もまとめて取ります。"

#. Help for the bulk return action. The original box can be out of range but must still be loaded in the game.
#: src/PaintManager/Scripts/paintmanager/locales/en_ui.lua:70
msgctxt "ui.transfer.return_all_help"
msgid "Return cans brought by PaintManager to their original boxes, including loaded boxes outside ship range."
msgstr "PaintManagerで取り出した缶をそれぞれ元の箱に戻します。船から離れた箱でも、ゲーム内に読み込まれていれば戻せます。"

#. Selected paint card. {count} is the number of cans of this color already in the backpack.
#: src/PaintManager/Scripts/paintmanager/locales/en_ui.lua:72 src/PaintManager/Scripts/paintmanager/ui.lua
#, python-brace-format
msgctxt "ui.transfer.backpack_count"
msgid "Backpack: {count}"
msgstr "バックパック：{count}"

#. Temporary label on the selected paint card while the mod reads the backpack contents.
#: src/PaintManager/Scripts/paintmanager/locales/en_ui.lua:74 src/PaintManager/Scripts/paintmanager/ui.lua
msgctxt "ui.transfer.backpack_loading"
msgid "Checking backpack..."
msgstr "バックパックを確認中…"

#. Paint list tab containing colors whose recipes the character has already learned.
#: src/PaintManager/Scripts/paintmanager/locales/en_ui.lua:79 src/PaintManager/Scripts/paintmanager/ui.lua
msgctxt "ui.tab.learned"
msgid "Learned"
msgstr "習得済み"

#. Paint list tab containing unlearned recipes with enough matching cans to learn now.
#: src/PaintManager/Scripts/paintmanager/locales/en_ui.lua:81 src/PaintManager/Scripts/paintmanager/ui.lua
msgctxt "ui.tab.ready"
msgid "Can Learn"
msgstr "習得可能"

#. Paint list tab for unlearned recipes for which the player still needs matching cans.
#: src/PaintManager/Scripts/paintmanager/locales/en_ui.lua:83 src/PaintManager/Scripts/paintmanager/ui.lua
msgctxt "ui.tab.missing"
msgid "Need Cans"
msgstr "塗料缶不足"

#. Navigation tab for ordinary player preferences, including transfers, appearance and scan radius.
#: src/PaintManager/Scripts/paintmanager/locales/en_ui.lua:85 src/PaintManager/Scripts/paintmanager/ui.lua
msgctxt "ui.tab.settings"
msgid "Settings"
msgstr "設定"

#. Paint category tab caption. {name} is the localized tab name and {count} is the number of colors in that category.
#: src/PaintManager/Scripts/paintmanager/locales/en_ui.lua:106 src/PaintManager/Scripts/paintmanager/ui.lua
#, python-brace-format
msgctxt "ui.tab.count"
msgid "{name} ({count})"
msgstr "{name}（{count}）"

#. Settings checkbox for displaying each paint name below its tile in the grid.
#: src/PaintManager/Scripts/paintmanager/locales/en_ui.lua:108 src/PaintManager/Scripts/paintmanager/ui.lua
msgctxt "ui.settings.names"
msgid "Show paint names"
msgstr "塗料名を表示"

#. Checkbox in ordinary Settings that reveals or hides the English-language Debug tab.
#: src/PaintManager/Scripts/paintmanager/locales/en_ui.lua:110 src/PaintManager/Scripts/paintmanager/ui.lua
msgctxt "ui.settings.developer"
msgid "Show developer tools"
msgstr "開発者ツールを表示"

#. Settings control for switching the size of paint tiles in the grid.
#: src/PaintManager/Scripts/paintmanager/locales/en_ui.lua:112 src/PaintManager/Scripts/paintmanager/ui.lua
msgctxt "ui.settings.density"
msgid "Tile size"
msgstr "タイルのサイズ"

#. Current tile size on the Settings button. {value} is the translated Compact or Comfortable size option.
#: src/PaintManager/Scripts/paintmanager/locales/en_ui.lua:114 src/PaintManager/Scripts/paintmanager/ui.lua
#, python-brace-format
msgctxt "ui.settings.density_value"
msgid "Tiles: {value}"
msgstr "タイル：{value}"

#. Smaller tile size value in Settings. Used in the caption for the plural noun meaning paint tiles.
#: src/PaintManager/Scripts/paintmanager/locales/en_ui.lua:116 src/PaintManager/Scripts/paintmanager/ui.lua
msgctxt "ui.settings.compact"
msgid "Compact"
msgstr "コンパクト"

#. Larger tile size value in Settings. Used in the caption for the plural noun meaning paint tiles.
#: src/PaintManager/Scripts/paintmanager/locales/en_ui.lua:118 src/PaintManager/Scripts/paintmanager/ui.lua
msgctxt "ui.settings.comfortable"
msgid "Comfortable"
msgstr "標準"

#. Settings control for cycling through sort orders for paints.
#: src/PaintManager/Scripts/paintmanager/locales/en_ui.lua:120 src/PaintManager/Scripts/paintmanager/ui.lua
msgctxt "ui.settings.sort"
msgid "Sort order"
msgstr "並べ替え"

#. Settings label above distance options. The radius is measured from the ship for both storage scans and connection.
#: src/PaintManager/Scripts/paintmanager/locales/en_ui.lua:122 src/PaintManager/Scripts/paintmanager/ui.lua
msgctxt "ui.settings.ship_radius"
msgid "Ship scan radius"
msgstr "船のスキャン半径"

#. Settings heading for the single-color transfer target. Counts cans already in the backpack toward the target.
#: src/PaintManager/Scripts/paintmanager/locales/en_ui.lua:124 src/PaintManager/Scripts/paintmanager/ui.lua
msgctxt "ui.settings.backpack_target"
msgid "Backpack target for selected paint"
msgstr "選んだ色の目標所持数"

#. Settings section for moving paint cans between the backpack and storage boxes.
#: src/PaintManager/Scripts/paintmanager/locales/en_ui.lua:126 src/PaintManager/Scripts/paintmanager/ui.lua
msgctxt "ui.settings.paint_transfers"
msgid "Paint transfers"
msgstr "塗料の移動"

#. Settings checkbox that extends the game's Deposit similar action to match paint of every color if the destination already has paint.
#: src/PaintManager/Scripts/paintmanager/locales/en_ui.lua:128 src/PaintManager/Scripts/paintmanager/ui.lua
msgctxt "ui.settings.deposit_similar_all_colors"
msgid "Group all colors in Deposit similar"
msgstr "「類似アイテムを預ける」で全色をまとめる"

#. Settings checkbox controlling the extra paint-only button on a game's open storage box. Use the same button name as ui.transfer.deposit_all_paints.
#: src/PaintManager/Scripts/paintmanager/locales/en_ui.lua:130 src/PaintManager/Scripts/paintmanager/ui.lua
msgctxt "ui.settings.show_deposit_all_paints"
msgid "Show Deposit all paints button"
msgstr "「塗料をすべて収納」ボタンを表示"

#. Help for the player option that changes the game's existing Deposit similar action. This applies to different paint colors.
#: src/PaintManager/Scripts/paintmanager/locales/en_ui.lua:132
msgctxt "ui.settings.help.depositSimilarAllColors"
msgid "When a box already holds paint, Deposit similar also moves backpack paints of other colors. Turn this off to use the game's usual matching rules."
msgstr "箱に塗料が入っていれば、「類似アイテムを預ける」でバックパックにある別の色の塗料も移せます。オフにするとゲーム標準の判定を使います。"

#. Help for showing the mod's paint-only button in the game's open storage menu. Both inventories must contain paint.
#: src/PaintManager/Scripts/paintmanager/locales/en_ui.lua:134
msgctxt "ui.settings.help.showDepositAllPaints"
msgid "Show a separate paint-only button in the open box when both the box and your backpack contain paint. It works independently of Deposit similar."
msgstr "開いた箱とバックパックの両方に塗料があるとき、塗料だけを収納するボタンを表示します。「類似アイテムを預ける」の設定に関係なく使えます。"

#. Quantity option in transfer settings. Takes as many cans of the selected color as will fit in the backpack.
#: src/PaintManager/Scripts/paintmanager/locales/en_ui.lua:136 src/PaintManager/Scripts/paintmanager/ui.lua
msgctxt "ui.settings.all_cans"
msgid "All"
msgstr "すべて"

#. Placeholder for entering a custom target number of cans in transfer settings.
#: src/PaintManager/Scripts/paintmanager/locales/en_ui.lua:138 src/PaintManager/Scripts/paintmanager/ui.lua
msgctxt "ui.settings.custom_cans"
msgid "Custom amount"
msgstr "数量を指定"

#. Button that saves the custom backpack target quantity entered in the field beside it.
#: src/PaintManager/Scripts/paintmanager/locales/en_ui.lua:140 src/PaintManager/Scripts/paintmanager/ui.lua
msgctxt "ui.settings.apply_quantity"
msgid "Apply"
msgstr "適用"

#. Validation error for the custom backpack target. {maximum} is the largest permitted number of cans of one color.
#: src/PaintManager/Scripts/paintmanager/locales/en_ui.lua:142 src/PaintManager/Scripts/paintmanager/ui.lua
#, python-brace-format
msgctxt "ui.settings.invalid_backpack_target"
msgid "Enter a whole number from 1 to {maximum}."
msgstr "1から{maximum}までの整数を入力してください。"

#. Help for the paint-name checkbox in ordinary Settings. The detail card keeps showing names when grid labels are hidden.
#: src/PaintManager/Scripts/paintmanager/locales/en_ui.lua:144
msgctxt "ui.settings.help.showNames"
msgid "Show each paint's name below its thumbnail. Turn this off for a picture-only grid. Select a paint to read its name in the detail card."
msgstr "タイルの画像の下に塗料名を表示します。オフにすると画像だけを表示します。塗料を選ぶと詳細欄で名前を確認できます。"

#. Help beside the developer-tools checkbox in ordinary Settings. Debug is the name of the English-only developer tab.
#: src/PaintManager/Scripts/paintmanager/locales/en_ui.lua:146
msgctxt "ui.settings.help.showDeveloperTools"
msgid "Show the Debug tab for reports, timing measurements and processing controls. Hiding Debug restores the default processing settings after pending work settles."
msgstr "レポート、処理時間の計測、処理設定を扱う「Debug」タブを表示します。非表示にすると、保留中の処理が終わった時点で処理設定が初期値に戻ります。"

#. Help explaining the two paint grid sizes on the Settings page.
#: src/PaintManager/Scripts/paintmanager/locales/en_ui.lua:148
msgctxt "ui.settings.help.density"
msgid "Switch between comfortable and compact paint tiles. Compact tiles fit more colors in each row."
msgstr "塗料タイルのサイズを標準とコンパクトから選べます。コンパクトにすると1行により多くの色が並びます。"

#. Help for cycling through paint sort modes. Favorites stay above other colors in each list.
#: src/PaintManager/Scripts/paintmanager/locales/en_ui.lua:150
msgctxt "ui.settings.help.sort"
msgid "Cycle through name A–Z, name Z–A, most cans first and fewest cans first. Favorites appear first within each paint list."
msgstr "名前の昇順、名前の降順、缶数の多い順、缶数の少ない順に切り替えます。どの一覧でもお気に入りの色を先に表示します。"

#. Help for the single-color backpack target. Keep the example arithmetic and distinguish this control from the all-colors bulk action.
#: src/PaintManager/Scripts/paintmanager/locales/en_ui.lua:152
msgctxt "ui.settings.help.quantity"
msgid "Choose how many cans of the selected color to keep in your backpack. If you choose 5 and carry 2, the selected-paint action takes up to 3 more from ship boxes. All takes as many as fit. The bulk action collects every color that fits."
msgstr "選んだ色をバックパックに何缶そろえるかを設定します。たとえば目標が5缶で2缶持っている場合、その色を補充すると船の箱から最大3缶取ります。「すべて」なら入る分だけ取ります。全色をまとめて移す操作では、色を問わず入るだけ取ります。"

#. Help for scan radius in Settings. The ship is the center both for finding boxes and for the player's connection.
#: src/PaintManager/Scripts/paintmanager/locales/en_ui.lua:154
msgctxt "ui.settings.help.ship_radius"
msgid "Distance from the ship's position used to find loaded storage boxes. You must also be inside this range to connect to PaintManager. The default is 35 m."
msgstr "船を中心に、この距離内でゲームに読み込まれた収納箱を探します。PaintManagerに接続するには、プレイヤーもこの範囲にいる必要があります。初期値は35 mです。"

#. Small fallback glyph shown on the favorite toggle when a paint is not a favorite and the star image is unavailable. Keep it to one glyph.
#: src/PaintManager/Scripts/paintmanager/locales/en_ui.lua:156 src/PaintManager/Scripts/paintmanager/ui.lua
msgctxt "ui.favorite.empty"
msgid "+"
msgstr "+"

#. Small fallback glyph shown on the favorite toggle when a paint is already a favorite and the star image is unavailable. Keep it to one glyph.
#: src/PaintManager/Scripts/paintmanager/locales/en_ui.lua:158 src/PaintManager/Scripts/paintmanager/ui.lua
msgctxt "ui.favorite.filled"
msgid "*"
msgstr "*"

#. Tooltip on the star button of a paint tile when this color is not in favorites.
#: src/PaintManager/Scripts/paintmanager/locales/en_ui.lua:160 src/PaintManager/Scripts/paintmanager/ui.lua
msgctxt "ui.favorite.add"
msgid "Add to favorites"
msgstr "お気に入りに追加"

#. Tooltip on the star button of a paint tile when this color is already a favorite.
#: src/PaintManager/Scripts/paintmanager/locales/en_ui.lua:162 src/PaintManager/Scripts/paintmanager/ui.lua
msgctxt "ui.favorite.remove"
msgid "Remove from favorites"
msgstr "お気に入りから削除"

#. Paint tile tooltip and details for a confirmed zero stock of the selected color.
#: src/PaintManager/Scripts/paintmanager/locales/en_ui.lua:169 src/PaintManager/Scripts/paintmanager/ui.lua
msgctxt "ui.tile.absent"
msgid "No cans in your backpack or ship boxes"
msgstr "バックパックと船の箱にこの色の塗料缶はありません"

#. Stock line for one paint color. {count} can be an exact quantity, a lower bound or a question mark.
#: src/PaintManager/Scripts/paintmanager/locales/en_ui.lua:171 src/PaintManager/Scripts/paintmanager/ui.lua
#, python-brace-format
msgctxt "ui.tile.stock"
msgid "Backpack and ship boxes: {count}"
msgstr "バックパックと船の箱：{count}"

#. Total number of cans across all colors in the backpack and scanned boxes. {count} may be exact, a lower bound, or unknown.
#: src/PaintManager/Scripts/paintmanager/locales/en_ui.lua:173 src/PaintManager/Scripts/paintmanager/ui.lua
#, python-brace-format
msgctxt "ui.stock.total"
msgid "Total cans: {count}"
msgstr "塗料缶の合計：{count}"

#. Compact inventory quantity when some stock could not be read. At least {count} physical cans were confirmed.
#: src/PaintManager/Scripts/paintmanager/locales/en_ui.lua:175 src/PaintManager/Scripts/paintmanager/ui.lua
#, python-brace-format
msgctxt "ui.tile.lower_bound"
msgid ">={count}"
msgstr "≥{count}"

#. Three-line hover tooltip on a paint tile. {name} is the game display name, {recipe} the translated recipe status and {stock} the translated stock description.
#: src/PaintManager/Scripts/paintmanager/locales/en_ui.lua:177 src/PaintManager/Scripts/paintmanager/ui.lua
#, python-brace-format
msgctxt "ui.tile.tooltip"
msgid ""
"{name}\n"
"{recipe}\n"
"{stock}"
msgstr ""
"{name}\n"
"{recipe}\n"
"{stock}"

#. Prompt in the paint details card before a color is selected.
#: src/PaintManager/Scripts/paintmanager/locales/en_ui.lua:179 src/PaintManager/Scripts/paintmanager/ui.lua
msgctxt "ui.paint.select"
msgid "Select a paint to view its details."
msgstr "塗料を選ぶと詳細を確認できます。"

#. Two lines in the selected paint card. {recipe} is the translated recipe status and {stock} the translated inventory line.
#: src/PaintManager/Scripts/paintmanager/locales/en_ui.lua:181 src/PaintManager/Scripts/paintmanager/ui.lua
#, python-brace-format
msgctxt "ui.paint.details"
msgid ""
"{recipe}\n"
"{stock}"
msgstr ""
"{recipe}\n"
"{stock}"

#. Tooltip for learning one recipe on the selected paint card. The four matching cans are checked but never consumed or moved.
